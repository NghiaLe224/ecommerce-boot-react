# ----------------------
# Global environment
# ----------------------
APP_NAME=sb-ecom

# ----------------------
# MySQL
# ----------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ecom
MYSQL_ROOT_PASSWORD=change_me   # Change this in your local .env 

# Optionally create an app user (uncomment to use)
# MYSQL_USER=appuser
# MYSQL_PASSWORD=change_me_too

# ----------------------
# Spring Boot
# ----------------------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://$MYSQL_HOST:$MYSQL_PORT/$MYSQL_DATABASE?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=$MYSQL_ROOT_PASSWORD

# If your app uses JWT or other secrets, add them here as well:
# JWT_SECRET=please_change_me
# REFRESH_TOKEN_SECRET=please_change_me
DB_PASSWORD=change_me
AWS_ACCESS_KEY=change_me
AWS_SECRET_KEY=change_me
JWT_SECRET=change_me